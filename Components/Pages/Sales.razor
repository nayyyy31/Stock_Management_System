@page "/sales"
@using Microsoft.EntityFrameworkCore
@inject NavigationManager NavManager
@inject IDbContextFactory<SMS.Data.AppDbContext> DbFactory



<div class="sales-container">
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-banner">Database Error: @errorMessage</div>
    }

    <!-- Table Section -->
    <div class="table-wrapper">
        <table class="sales-table">
            <thead>
                <tr>
                    <th class="col-date">Date</th>
                    <th class="col-inv">Invoice No</th>
                    <th class="col-qty">QTY</th>
                    <th class="col-amount">Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in salesHistory)
                {
                    var current = item;
                    <tr class="@(selectedItem?.Id == current.Id ? "selected-row" : null)"
                        @onclick="() => SelectRow(current)">
                        <td class="col-date" @onclick="() => SelectRow(current)">@current.SaleDate.ToString("dd/MM/yyyy")</td>
                        <td class="col-inv" @onclick="() => SelectRow(current)">@current.InvoiceNo</td>
                        <td class="col-qty" @onclick="() => SelectRow(current)">@current.TotalQty</td>
                        <td class="col-amount" @onclick="() => SelectRow(current)">@current.TotalAmount.ToString("N0")</td>
                    </tr>
                }
                <tr class="spacer-row">
                    <td class="col-date"></td>
                    <td class="col-inv"></td>
                    <td class="col-qty"></td>
                    <td class="col-amount"></td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Fixed Bottom Bar -->
    <footer class="bottom-bar">
        <div class="action-buttons">
            <button class="icon-btn" @onclick="HandleNewSale">
                <span class="icon">&#65291;</span>
                <span class="label">New</span>
            </button>
            <button class="icon-btn" @onclick="HandleEditSale" disabled="@(selectedItem == null)">
                <span class="icon">&#9998;</span>
                <span class="label">Edit</span>
            </button>
        </div>

        <div class="totals-display">
            <span class="total-qty">@TotalQuantity</span>
            <span class="total-amount">@TotalAmount.ToString("N0")</span>
        </div>
    </footer>
</div>


@code {
    private List<SMS.Data.SaleEntity> salesHistory = new();
    private SMS.Data.SaleEntity? selectedItem;
    private string? errorMessage;

    private int TotalQuantity => salesHistory.Sum(x => x.TotalQty);
    private decimal TotalAmount => salesHistory.Sum(x => x.TotalAmount);

    protected override async Task OnInitializedAsync()
    {
        await LoadSales();
    }

    private async Task LoadSales()

    {
        await using var context = await DbFactory.CreateDbContextAsync();
        try
        {
            salesHistory = await context.Sales
                .AsNoTracking()
                .OrderByDescending(s => s.InvoiceNo)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.InnerException != null ? ex.InnerException.Message : ex.Message;
        }
    }

    private void SelectRow(SMS.Data.SaleEntity item)
    {
        selectedItem = item;
        StateHasChanged();
    }

    private void HandleNewSale()
    {
        NavManager.NavigateTo("sales-entry");
    }

    private void HandleEditSale()
    {
        if (selectedItem != null)
        {
            NavManager.NavigateTo($"sales-edit/{selectedItem.Id}");
        }
    }
}